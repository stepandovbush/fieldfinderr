# Copy this file to ".env" and paste your real Groq keys.
# 3 keys are rotated round-robin with automatic failover.
LLM_API_KEY_1=
LLM_API_KEY_2=
LLM_API_KEY_3=

# Models (Groq). Change if a model name is deprecated.
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
